htmlcov/
coverage.xml

# Local database state, dumps and backups (Django migrations stay tracked)
db.sqlite3
*.sqlite3
*.sqlite
*.db
*.dump
*.sql
*.sql.gz
*.sql.zip
*.backup
*.bak

# User CVs and private storage: directory patterns, NOT *.pdf or *.docx
